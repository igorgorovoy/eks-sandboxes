MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="BOUNDARY"

--BOUNDARY
Content-Type: application/node.eks.aws

---
apiVersion: node.eks.aws/v1alpha1
kind: NodeConfig
spec:
  containerd:
    # The AL2023 EKS AMI ships containerd 2.x with NO runsc runtime entry by default
    # (verified: a node without this NodeConfig fails with "no runtime for runsc is
    # configured"). nodeadm normalizes the 1.7-style key into the v2 config path, so
    # the old-style section below works on both. Alternative v2 syntax, if ever needed:
    #   [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc]
    config: |
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
        runtime_type = "io.containerd.runsc.v1"

--BOUNDARY
Content-Type: text/x-shellscript; charset="us-ascii"

#!/bin/bash
set -euo pipefail

# Pinned release for a reproducible benchmark. Latest gVisor releases ship a
# bundle (gvisor.tar.zstd) instead of standalone binaries; the old
# "release/latest/x86_64/runsc" URL returns 404 (verified Nov 11, 2026).
GVISOR_RELEASE="20261102.0"

ARCH="$(uname -m)"
URL="https://storage.googleapis.com/gvisor/releases/release/${GVISOR_RELEASE}/${ARCH}"

command -v zstd >/dev/null || dnf install -y zstd

cd /tmp
curl -fsSLO "${URL}/gvisor.tar.zstd"
curl -fsSLO "${URL}/gvisor.tar.zstd.sha512"
sha512sum -c gvisor.tar.zstd.sha512

tar --zstd -xf gvisor.tar.zstd
chmod a+rx runsc containerd-shim-runsc-v1
mv runsc containerd-shim-runsc-v1 /usr/local/bin/

# Sanity check: runtime must print its version
/usr/local/bin/runsc --version

--BOUNDARY--
